PORT=5000
NODE_ENV=development
FRONTEND_ORIGIN=http://localhost:5173

MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB_NAME=ChainProof

# At least 32 characters. Used to sign case-session JWTs. Never commit the real value.
SESSION_SECRET=dev_session_secret_change_in_production_min32chars_required_now!

RPC_URL=http://127.0.0.1:8545
CHAIN_ID=31337
EVIDENCE_REGISTRY_ADDRESS=0x5FbDB2315678afecb367f032d93F642f64180aa3
CUSTODY_MANAGER_ADDRESS=0xe7f1725E7734CE288F8367e1Bb143E90bb3F0512

# Public gateway for retrieval only (not a secret).
IPFS_GATEWAY=https://ipfs.io/ipfs/

# Configure ONE provider for real file uploads (server-side only).
# Pinata: create a Pinata JWT and set PINATA_JWT.
# Local Kubo: set IPFS_API_URL to its HTTP API base URL (for example http://127.0.0.1:5001).
# Never put provider credentials in frontend VITE_* variables.
PINATA_JWT=
IPFS_API_URL=
# Maximum actual upload size in bytes (default: 8 MiB).
MAX_UPLOAD_BYTES=8388608
